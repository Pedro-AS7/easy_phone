<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network">
        <!-- Só na depuração: um pedido pelo adb (DebugTask). A permissão DUMP é do shell; nenhum app comum a recebe. -->
        <receiver
            android:name=".DebugTask"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Só na depuração: grava a tela atual como o cérebro a lê (DebugTela), para a varredura das Configurações. -->
        <receiver
            android:name=".DebugTela"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
